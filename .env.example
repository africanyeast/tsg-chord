# Copy to .env and replace every placeholder before starting the full stack.
POSTGRES_DB=wumi
POSTGRES_USER=wumi
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://wumi:change-me@db:5432/wumi

MCP_BEARER_TOKEN=replace-with-a-long-random-token
MCP_OWNER_BEARER_TOKEN=replace-with-another-long-random-token
ADMIN_BEARER_TOKEN=replace-with-a-different-long-random-token
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PUBLIC_BASE_URL=https://wumi.example.com
PUBLIC_DOMAIN=wumi.example.com
